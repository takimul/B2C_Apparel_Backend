    {
      "name": "02 Authentication",
      "item": [
        {
          "name": "Admin login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeds', function () { pm.expect(pm.response.code).to.equal(200); });",
                  "const j = pm.response.json();",
                  "pm.expect(j.success).to.equal(true);",
                  "const token = j.data && (j.data.token || j.data.accessToken);",
                  "if (token) pm.environment.set('accessToken', token);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Authentication cookie was set', function () {",
                  "  const cookies = pm.cookies.toObject();",
                  "  pm.expect(Object.keys(cookies)).to.include('verigo_access_token');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/admin/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Me succeeds', function () { pm.expect(pm.response.code).to.equal(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid login rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"{{adminEmail}}\", \"password\": \"definitely-wrong-password\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid credentials rejected', function () { pm.expect(pm.response.code).to.be.oneOf([400,401]); });"
                ]
              }
            }
          ]
        }
