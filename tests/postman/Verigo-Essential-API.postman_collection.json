  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === 'Health check') {",
          "  const runId = Date.now().toString(36);",
          "  pm.environment.set('runId', runId);",
          "  pm.environment.set('categoryName', `[API TEST] Hoodies ${runId}`);",
          "  pm.environment.set('categorySlug', `api-test-hoodies-${runId}`);",
          "  pm.environment.set('productName', `[API TEST] Premium Hoodie ${runId}`);",
          "  pm.environment.set('productSlug', `api-test-premium-hoodie-${runId}`);",
          "}",
          "pm.request.headers.upsert({key:'Accept', value:'application/json'});"
        ]
      }
    }
  ],
